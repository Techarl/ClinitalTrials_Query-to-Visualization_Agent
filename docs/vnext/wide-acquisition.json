            "outcomesModule": {
              "primaryOutcomes": [
                {
                  "measure": "Change in Histamine provocative concentration causing 20% fall in FEV1 (PC20)at 6 weeks",
                  "description": "Measurement of airway hyper-reactivity (a hallmark of asthma).",
                  "timeFrame": "Change from baseline to 6 weeks"
                }
              ],
              "secondaryOutcomes": [
                {
                  "measure": "Change in Impulse oscillometry parameters at 6 weeks",
