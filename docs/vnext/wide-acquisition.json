                  "timeFrame": "Change from baseline to 6 weeks"
                },
                {
                  "measure": "Change in resting blood pressure at 6 weeks",
                  "description": "Blood pressure will be monitored at each visit, or if patients develop symptoms that may be due to low blood pressure.",
                  "timeFrame": "Change from baseline to 6 weeks"
                },
                {
                  "measure": "Change in exhaled tidal nitric oxide levels at 6 weeks",
                  "timeFrame": "Change from baseline to 6 weeks"
                },
