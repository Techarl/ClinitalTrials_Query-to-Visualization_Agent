{
  "$defs": {
    "Advisory": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "default": "warning",
          "enum": [
            "info",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "rule_version": {
          "default": "chart-advisories-v1",
          "title": "Rule Version",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Advisory",
      "type": "object"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "statistics_basis": {
          "enum": [
            "complete_records",
            "official_counts",
            "literature",
            "entity"
          ],
          "title": "Statistics Basis",
          "type": "string"
        },
        "count_exactness": {
          "enum": [
            "exact",
            "not_applicable",
            "incomplete"
          ],
          "title": "Count Exactness",
          "type": "string"
        },
        "population_coverage": {
          "enum": [
            "complete",
            "count_only",
            "incomplete",
            "not_applicable"
          ],
          "title": "Population Coverage",
          "type": "string"
        },
        "evidence_coverage": {
          "enum": [
            "complete_contributors",
            "sample_only",
            "article_metadata",
            "mapping_sources"
          ],
          "title": "Evidence Coverage",
          "type": "string"
        },
        "fetched_count": {
          "minimum": 0,
          "title": "Fetched Count",
          "type": "integer"
        },
        "matched_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Matched Count"
        }
      },
      "required": [
        "statistics_basis",
        "count_exactness",
        "population_coverage",
        "evidence_coverage",
        "fetched_count"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "goal_id": {
      "title": "Goal Id",
      "type": "string"
    },
    "source_type": {
      "enum": [
        "clinicaltrials",
        "pubmed",
        "entity"
      ],
      "title": "Source Type",
      "type": "string"
    },
    "scope_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope Id"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "metric": {
      "title": "Metric",
      "type": "string"
    },
    "visualization": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Visualization"
    },
    "coverage": {
      "$ref": "#/$defs/Coverage"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/Advisory"
      },
      "title": "Warnings",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Metadata",
      "type": "object"
    },
    "alternative_renderers": {
      "items": {
        "type": "string"
      },
      "title": "Alternative Renderers",
      "type": "array"
    }
  },
  "required": [
    "artifact_id",
    "result_id",
    "goal_id",
    "source_type",
    "title",
    "metric",
    "coverage"
  ],
  "title": "Artifact",
  "type": "object"
}
