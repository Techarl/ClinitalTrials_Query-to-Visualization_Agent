{
  "$defs": {
    "DateRange": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "default": "start",
          "enum": [
            "start",
            "primary_completion",
            "completion",
            "first_posted"
          ],
          "title": "Field",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "precision_policy": {
          "const": "contained",
          "default": "contained",
          "title": "Precision Policy",
          "type": "string"
        }
      },
      "title": "DateRange",
      "type": "object"
    },
    "Filters": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "interventions": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Interventions",
          "type": "array"
        },
        "intervention_match": {
          "default": "any",
          "enum": [
            "any",
            "all"
          ],
          "title": "Intervention Match",
          "type": "string"
        },
        "sponsor": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sponsor"
        },
        "phases": {
          "items": {
            "enum": [
              "EARLY_PHASE1",
              "PHASE1",
              "PHASE2",
              "PHASE3",
              "PHASE4",
              "NA"
            ],
            "type": "string"
          },
          "title": "Phases",
          "type": "array"
        },
        "statuses": {
          "items": {
            "enum": [
              "RECRUITING",
              "NOT_YET_RECRUITING",
              "ACTIVE_NOT_RECRUITING",
              "ENROLLING_BY_INVITATION",
              "COMPLETED",
              "SUSPENDED",
              "TERMINATED",
              "WITHDRAWN",
              "UNKNOWN",
              "AVAILABLE",
              "NO_LONGER_AVAILABLE",
              "TEMPORARILY_NOT_AVAILABLE",
              "APPROVED_FOR_MARKETING",
              "WITHHELD"
            ],
            "type": "string"
          },
          "title": "Statuses",
          "type": "array"
        },
        "countries": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Countries",
          "type": "array"
        },
        "start_year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Year"
        },
        "end_year": {
          "anyOf": [
            {
              "maximum": 2200,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Year"
        },
        "enrollment_type": {
          "anyOf": [
            {
              "enum": [
                "ACTUAL",
                "ESTIMATED"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enrollment Type"
        }
      },
      "title": "Filters",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "query": {
      "maxLength": 6000,
      "minLength": 1,
      "title": "Query",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Session Id"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "submission_id": {
      "anyOf": [
        {
          "maxLength": 100,
          "minLength": 16,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Submission Id"
    },
    "filters": {
      "anyOf": [
        {
          "$ref": "#/$defs/Filters"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "date_range": {
      "anyOf": [
        {
          "$ref": "#/$defs/DateRange"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "intervention_scope": {
      "anyOf": [
        {
          "enum": [
            "population",
            "comparison"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intervention Scope"
    },
    "source_mode": {
      "default": "full_evidence",
      "enum": [
        "full_evidence",
        "aggregate_overview"
      ],
      "title": "Source Mode",
      "type": "string"
    },
    "language": {
      "default": "en",
      "enum": [
        "en",
        "zh"
      ],
      "title": "Language",
      "type": "string"
    }
  },
  "required": [
    "query"
  ],
  "title": "RunRequest",
  "type": "object"
}
