# Loaded by app.config.Settings. Environment variables override this file's values.
# Copy to .env, then fill the three blank secret fields locally.
# Never put real credentials in this example or commit your .env.

# Main agent: OpenAI Platform, Responses API.
OPENAI_API_KEY=""
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-sol
# Baseline: medium. Change explicitly to high for a separate comparison.
OPENAI_REASONING_EFFORT=medium
# Maps to max_output_tokens, including both reasoning and visible output tokens.
OPENAI_MAX_OUTPUT_TOKENS=32768
OPENAI_TIMEOUT_SECONDS=120
# Long context is a model capability; there is no app long_context toggle here.
# Keep raw trial snapshots outside prompts and build bounded task context.

# Future decision experiment: OpenRouter Decisions API, separate from chat APIs.
# The key is optional while the experiment is disabled.
OPENROUTER_API_KEY=""
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# Pin a version for reproducibility; do not use a moving latest alias.
OPENROUTER_DECISION_MODEL=typesafe/jev-1.14
ENABLE_DECISION_EXPERIMENT=false

# Future harness experiment: reserve configuration only.
ENABLE_HARNESS_EXPERIMENT=false
HARNESS_VERSION=baseline-v1

# Local Neo4j Desktop instance. Confirm URI/port in Desktop after starting it.
# Use the database instance credentials, not your Neo4j website account.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=""
NEO4J_DATABASE=neo4j

# Planned local storage for immutable snapshots, SQLite state, and run traces.
APP_DATA_DIR=./data
APP_TIMEZONE=Asia/Shanghai
